# Auto detect text files and normalize line endings to LF
* text=auto

# Shell scripts
*.sh text eol=lf
*.bash text eol=lf

# Windows
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# JavaScript/Node
*.js text eol=lf
*.json text eol=lf
*.ts text eol=lf

# Documentation
*.md text eol=lf
*.MD text eol=lf

# SQL
*.sql text eol=lf

# YAML
*.yml text eol=lf
*.yaml text eol=lf

# Docker
Dockerfile text eol=lf
docker-compose.yml text eol=lf
