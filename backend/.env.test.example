# Backend Environment Variables — BANCO DE TESTE
#
# Modelo do .env.test, que o tests/env.setup.js carrega antes de qualquer
# outro módulo e que o `npm run migrate:test` também usa. São as mesmas
# chaves do .env.example com os valores do ambiente de teste.
#
# A separação não é organizacional, é proteção: 17 testes de integração
# apagam campeonatos no afterAll. Se o .env.test sumir, o dotenv não
# reclama — ele só não carrega nada, o src/config/database.js cai no .env
# de desenvolvimento, e a suíte passa a apagar os seus dados de trabalho
# sem uma única mensagem de erro.

# Database — repare no _test no nome. É a diferença que importa.
DB_USER=champy_user
DB_PASSWORD=champy_password
DB_NAME=champy_championship_test
DB_HOST=localhost
DB_PORT=5432
# O banco de teste é o mesmo container local, que não expõe certificado.
DB_SSL=false

# Server
# 'test' desliga o rate limit (src/middleware/rateLimiter.js) e o log de
# requisição: a suíte faz dezenas de chamadas de auth em sequência rápida
# dentro do mesmo processo, e os limites de produção só a quebrariam sem
# ganhar segurança nenhuma.
NODE_ENV=test
# PORT não aparece aqui porque a suíte não usa: o supertest sobe o app em
# memória, e o único teste que abre porta de verdade (websocket) pede uma
# livre ao sistema com listen(0).

# Fuso do processo.
# A suíte NÃO carrega src/server.js — o supertest importa src/app.js direto —
# então o TZ que o server.js fixa na primeira linha nunca vale aqui. Sem esta
# variável, os testes rodam no fuso da máquina: UTC-3 no PC do desenvolvedor,
# UTC no runner do GitHub Actions. Como heats-schedule.test.js verifica
# horário de bateria, deixar isso solto é deixar o resultado depender de onde
# o teste rodou.
TZ=America/Sao_Paulo

# JWT
JWT_SECRET=jest-test-secret-nao-usar-em-producao
# JWT_EXPIRES_IN fica de fora de propósito: sem ele vale o padrão de 24h do
# src/middleware/auth.js, mais que suficiente para uma suíte de 80 segundos.

# CORS
CORS_ORIGIN=http://localhost:3000

# LOG_LEVEL fica DELIBERADAMENTE ausente. O tests/env.setup.js define a chave
# vazia antes de tudo, justamente para barrar o LOG_LEVEL=debug que viria do
# .env de desenvolvimento e enterraria o resultado da suíte sob o SQL de cada
# query. Para depurar uma execução específica: LOG_LEVEL=debug npm test.
