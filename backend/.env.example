# Backend Environment Variables
#
# Só as variáveis que o código realmente lê (procure por process.env no
# backend). Chaves que não são lidas em lugar nenhum saíram daqui de
# propósito: um .env.example que promete configuração inexistente faz quem
# chega ao projeto perder tempo configurando algo sem efeito.

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=champy_user
DB_PASSWORD=your_password_here
DB_NAME=champy_championship
# Liga TLS na conexão com o Postgres. Obrigatório em banco hospedado (Neon,
# Render); deixe desligado no Postgres local do Docker, que não expõe
# certificado nenhum — ver src/config/database.js.
DB_SSL=false

# Server
# Em produção precisa ser exatamente 'production': é esse valor que liga
# "trust proxy" no src/app.js. Sem ele, todos os visitantes que chegam pelo
# mesmo proxy contam como um IP só e dividem o mesmo balde de rate limit.
NODE_ENV=development
# A hospedagem normalmente injeta a porta sozinha; src/server.js usa 5000
# quando a variável não existe.
PORT=5000
# Só o valor literal 'debug' liga o log de cada query executada
# (src/config/database.js). Qualquer outro valor, ou a ausência da variável,
# deixa o log quieto. NÃO use 'debug' em produção: joga todo o SQL do
# campeonato nos logs da hospedagem.
LOG_LEVEL=debug

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# Validade do token de sessão. Aceita o formato do jsonwebtoken (24h, 72h,
# 7d) e é lida em src/middleware/auth.js; sem ela, o padrão é 24h. Em semana
# de evento vale subir para 72h: o organizador que cadastra equipes e provas
# na véspera chega na manhã seguinte com a sessão vencida — e descobre isso
# com o box cheio.
JWT_EXPIRES_IN=24h

# CORS
# Aceita vários valores separados por vírgula — ver src/config/cors.js.
# A mesma lista vale para o Socket.io, que usa o mesmo corsOriginChecker.
CORS_ORIGIN=http://localhost:3000

# Fuso do processo. O sistema fixa America/Sao_Paulo quando esta variavel nao
# existe (ver src/server.js): o backend precisa se comportar igual no PC do
# organizador, no container e na hospedagem, que sobem em fusos diferentes.
TZ=America/Sao_Paulo

# Scripts (não é configuração do servidor)
# Para onde o scripts/smoke-seed.js aponta. Sem ela, http://localhost:5000.
# Serve para semear o campeonato de teste contra um backend que não seja o
# local — o publicado, por exemplo, durante o ensaio antes do evento.
SMOKE_BASE_URL=http://localhost:5000
