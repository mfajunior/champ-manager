{
  "name": "champy-manager-backend",
  "version": "1.0.0",
  "description": "Backend para plataforma de gerenciamento de campeonatos CrossFit",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate": "node scripts/migrate.js",
    "migrate:test": "node -r dotenv/config scripts/migrate.js dotenv_config_path=.env.test",
    "seed": "node scripts/seed.js",
    "test": "jest --detectOpenHandles",
    "test:coverage": "jest --detectOpenHandles --coverage"
  },
  "keywords": [
    "crossfit",
    "championship",
    "tournament",
    "leaderboard"
  ],
  "author": "Milton Faria",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "2.4.3",
    "cors": "2.8.5",
    "dotenv": "16.3.1",
    "express": "4.22.3",
    "express-rate-limit": "8.7.0",
    "helmet": "7.0.0",
    "joi": "17.13.8",
    "jsonwebtoken": "9.0.2",
    "pg": "8.11.3",
    "socket.io": "4.8.3"
  },
  "devDependencies": {
    "jest": "29.7.0",
    "nodemon": "3.0.2",
    "socket.io-client": "^4.8.3",
    "supertest": "6.3.3"
  }
}
